  "additive_globs": [
    "docs/impact-challenge-*.md",
    "docs/critical-surface-inventory.md",
    "docs/impact-shop-profile-protected-perimeter.md",
    "docs/elementor-protected-surface.md",
    "docs/additive-first-ui-policy.md",
    "docs/protected-change-records/*.md",
    "scripts/check-elementor-protected-routes.sh",
    "scripts/guarded-remote-write.sh"
  ],
  "critical_routes": [
    "/impact-challenge/",
    "/impactad-2/",
    "/impactshop/",
    "/profil",
    "/go/*",
    "/go-deal/*"
  ],
  "required_smoke_tags": {
    "ads_watch_runtime": [
      "route:impact-challenge",
      "flow:video-start",
      "flow:cta-click",
      "flow:reward-accumulation",
      "browser:webkit",
      "browser:chrome"
    ],
    "offerwall_runtime": [
      "route:impact-challenge",
      "flow:video-tasks-roundtrip",
      "flow:offerwall-tabs",
      "browser:webkit",
      "browser:chrome"
    ],
    "pwa_shell": [
      "route:impact-challenge",
      "route:impactshop",
      "route:home",
      "flow:action-bar-clickability",
      "flow:consent-overlay",
      "flow:pwa-install-entry",
      "browser:mobile"
    ],
    "identity_and_points": [
      "route:impact-challenge",
      "route:profil",
      "flow:message-popup",
      "flow:points-jump",
      "flow:legacy-pool-visibility"
    ],
    "mobile_shell_runtime": [
      "route:impact-challenge",
      "route:impactshop",
      "route:home",
      "flow:mobile-shell-render",
      "flow:consent-overlay",
      "flow:pwa-install-entry",
      "flow:legacy-pool-visibility",
      "browser:mobile"
    ],
    "impact_shop_surface": [
      "route:impactshop",
      "flow:saved-offers-open",
      "flow:go-deal",
      "browser:webkit",
      "browser:chrome"
    ],
    "profile_identity_surface": [
      "route:profil",
      "flow:message-popup",
      "flow:points-jump",
      "flow:profile-open",
      "browser:webkit",
      "browser:chrome"
    ],
    "deploy_guard": [
      "deploy:guard-preflight",
      "deploy:checksum-verify"
    ]
  },
  "smoke_group_globs": {
    "ads_watch_runtime": [
      "wp-content/mu-plugins/impactshop-ads-watch.php",
      "wp-content/mu-plugins/impactshop-ads-watch.js",
      "wp-content/mu-plugins/impactshop-ads-watch.css",
