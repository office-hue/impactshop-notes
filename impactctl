#!/usr/bin/env bash
# ImpactCtl – Sharity ImpactShop terminálos vezérlő
# Deploy előtt/után REST preflight + Codex context refresh automatizálása
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODEX_REFRESH="$ROOT/bin/codex-refresh.sh"
DEPLOY_SCRIPT="$ROOT/bin/deploy-wpcontent-map.sh"
PREFLIGHT_SCRIPT="$ROOT/bin/preflight-check.sh"
PREFLIGHT_RUNNER="$ROOT/bin/preflight-run.sh"
DEFAULT_STAGING_ENV="$ROOT/.deploy.staging.env"
DEFAULT_PROD_ENV="$ROOT/.deploy.production.env"
CURRENT_ENV_LABEL=""
CURRENT_ENV_FILE=""

usage() {
  cat <<'USG'
ImpactCtl – Sharity ImpactShop vezérlő

Használat:
  ./impactctl deploy [staging|production|<env-file>]
  ./impactctl preflight [staging|production|<env-file>]
  ./impactctl refresh
  ./impactctl help

Környezeti változók:
  SKIP_PREFLIGHT=1   – preflight QA kihagyása (nem ajánlott)
USG
}

error() { echo "❌ $*" >&2; exit 1; }
warn() { echo "⚠️ $*" >&2; }
info() { echo "$*"; }

resolve_env() {
  local key="${1:-staging}"
  case "$key" in
    ""|staging|stage|stg)
      CURRENT_ENV_LABEL="staging"
      CURRENT_ENV_FILE="$DEFAULT_STAGING_ENV"
      ;;
    production|prod)
      CURRENT_ENV_LABEL="production"
      CURRENT_ENV_FILE="$DEFAULT_PROD_ENV"
      ;;
    --env=*)
      CURRENT_ENV_LABEL="$(basename "${key#--env=}")"
      CURRENT_ENV_FILE="${key#--env=}"
      ;;
    *)
      if [[ -f "$key" ]]; then
        CURRENT_ENV_LABEL="$(basename "$key")"
        CURRENT_ENV_FILE="$key"
      elif [[ -f "$ROOT/$key" ]]; then
        CURRENT_ENV_LABEL="$(basename "$key")"
        CURRENT_ENV_FILE="$ROOT/$key"
      else
        error "Ismeretlen környezet vagy fájl: $key"
      fi
      ;;
  esac
  [[ -f "$CURRENT_ENV_FILE" ]] || error "Környezeti fájl hiányzik: $CURRENT_ENV_FILE"
}

run_preflight() {
  local label="$1"
  local env_file="$2"
  if [[ -x "$PREFLIGHT_RUNNER" ]]; then
    "$PREFLIGHT_RUNNER" "$label"
  else
    [[ -x "$PREFLIGHT_SCRIPT" ]] || error "Hiányzik a preflight script: $PREFLIGHT_SCRIPT"
    "$PREFLIGHT_SCRIPT" "$env_file"
  fi
}

codex_refresh() {
  if [[ -x "$CODEX_REFRESH" ]]; then
    info "🧠 Codex context refresh futtatása…"
    if ! "$CODEX_REFRESH"; then
      warn "codex-refresh közben hiba történt (folytatok)."
    fi
  else
    warn "codex-refresh kihagyva (bin/codex-refresh.sh nem futtatható)."
  fi
}

deploy_cmd() {
  local env_key="${1:-staging}"
  [[ -x "$DEPLOY_SCRIPT" ]] || error "Hiányzik a deploy script: $DEPLOY_SCRIPT"
  resolve_env "$env_key"

  if [[ "${SKIP_PREFLIGHT:-0}" != "1" ]]; then
    info "🔎 Preflight (deploy előtt) → $CURRENT_ENV_FILE"
    run_preflight "$CURRENT_ENV_LABEL" "$CURRENT_ENV_FILE"
  else
    info "⏭️  Preflight kihagyva (SKIP_PREFLIGHT=1)"
  fi

  local env_arg="--env=$CURRENT_ENV_FILE"
  info "🚀 Deploy futtatása ($CURRENT_ENV_FILE)…"
  "$DEPLOY_SCRIPT" "$env_arg"

  if [[ "${SKIP_PREFLIGHT:-0}" != "1" ]]; then
    info "🔎 Preflight (deploy után) → $CURRENT_ENV_FILE"
    run_preflight "$CURRENT_ENV_LABEL" "$CURRENT_ENV_FILE"
  fi

  codex_refresh
}

preflight_cmd() {
  local env_key="${1:-staging}"
  resolve_env "$env_key"
  run_preflight "$CURRENT_ENV_LABEL" "$CURRENT_ENV_FILE"
}

refresh_cmd() {
  codex_refresh
}

cmd="${1:-}"; shift || true
case "$cmd" in
  deploy)     deploy_cmd "$@" ;;
  preflight)  preflight_cmd "$@" ;;
  refresh)    refresh_cmd ;;
  help|-h|--help|"") usage ;;
  *) error "Ismeretlen parancs: $cmd" ;;
esac
