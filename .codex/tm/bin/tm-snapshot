#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
TS="${1:-$(date +%Y%m%d_%H%M%S)}"
DEST_LOCAL="$ROOT/.codex/tm/snap-$TS"
DEST_HOME="$HOME/ImpactTimeMachine/$(basename "$ROOT")/snap-$TS"
mkdir -p "$DEST_LOCAL" "$DEST_HOME"

cd "$ROOT"
LIST_FILE="$DEST_LOCAL/files.list"
git -c core.quotePath=false ls-files > "$LIST_FILE"
cp "$LIST_FILE" "$DEST_HOME/files.list"

HASH_FILE="$DEST_LOCAL/hash.txt"
: > "$HASH_FILE"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if [ -f "$f" ]; then
    sha=$(shasum -a 256 "$f" | awk '{print $1}')
    printf "%s  %s\n" "$sha" "$f" >> "$HASH_FILE"
  fi
done < "$LIST_FILE"
cp "$HASH_FILE" "$DEST_HOME/hash.txt"

ARCHIVE="$DEST_LOCAL/files.tar.gz"
tar -czf "$ARCHIVE" -T "$LIST_FILE"
cp "$ARCHIVE" "$DEST_HOME/files.tar.gz"

git rev-parse HEAD > "$DEST_LOCAL/git_head.txt" || true
git status -sb > "$DEST_LOCAL/status.txt" || true
cp "$DEST_LOCAL/"*.txt "$DEST_HOME/" 2>/dev/null || true

echo "snap-$TS" > "$ROOT/.codex/tm/last"
echo "SNAPSHOT $TS READY: $DEST_LOCAL"
