# Szerver és WP helye (VALÓDI!)
SSH_HOST="sharityh@cp40.ezit.hu"
REMOTE_WP_PATH="/home/sharityh/app-staging"
REMOTE_WP_CONTENT="$REMOTE_WP_PATH/wp-content"

# Forrás → cél párosok (egy sor = egy mapping)
# Bal: a HELYI gépen lévő forrás mappa; Jobb: a TÁVOLI wp-content alatti cél
# (Ha a forrásaid máshol vannak, nyugodtan írhatsz abszolút/../ útvonalat is bal oldalra.)
MAPPINGS='
wp-content/mu-plugins                          -> mu-plugins
wp-content/plugins/advanced-custom-fields      -> plugins/advanced-custom-fields
wp-content/plugins/complianz-gdpr              -> plugins/complianz-gdpr
wp-content/plugins/complianz-terms-conditions  -> plugins/complianz-terms-conditions
wp-content/plugins/dognet-pap-publisher        -> plugins/dognet-pap-publisher
wp-content/plugins/hellopack-client            -> plugins/hellopack-client
wp-content/plugins/impact-bridge-local         -> plugins/impact-bridge-local
wp-content/plugins/impact-local-tops           -> plugins/impact-local-tops
wp-content/plugins/impact-mini-shortcodes      -> plugins/impact-mini-shortcodes
wp-content/plugins/impact-report-mvp           -> plugins/impact-report-mvp
wp-content/plugins/impact-short codes-legacy   -> plugins/impact-short codes-legacy
wp-content/plugins/impact-shortcodes           -> plugins/impact-shortcodes
wp-content/plugins/impact-simple-widgets       -> plugins/impact-simple-widgets
wp-content/plugins/impactshop-dognet-report    -> plugins/impactshop-dognet-report
wp-content/plugins/impactshop-report-compat    -> plugins/impactshop-report-compat
wp-content/plugins/impactshop-report-fixed     -> plugins/impactshop-report-fixed
wp-content/plugins/sharity-aff-check           -> plugins/sharity-aff-check
wp-content/plugins/sharity-impact-mini         -> plugins/sharity-impact-mini
wp-content/plugins/sharity-offers-import       -> plugins/sharity-offers-import
'

# HTTP preflight (deploy előtt REST ping)
PREFLIGHT_BASE_URL="https://sharity.hu/impactshop-staging"
PREFLIGHT_ENDPOINTS=(
  "/?rest_route=/impact/v1/totals"
  "/?rest_route=/impact/v1/ticker"
  "/?rest_route=/impact/v1/leaderboard"
  "/?rest_route=/impact/v1/report"
)
PREFLIGHT_TIMEOUT=10

# rsync opciók
RSYNC_OPTS="-az --delete --info=progress2 --exclude='.git' --exclude='node_modules' --exclude='.DS_Store'"
