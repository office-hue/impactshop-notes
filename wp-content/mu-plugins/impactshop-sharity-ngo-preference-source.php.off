<?php
/**
 * Sharity NGO preference source adapter (intentionally disabled).
 *
 * This file must retain the .off suffix until a separately approved release.
 * The pure helpers are deliberately dependency-light so the contract test is
 * hermetic; no schema, network call, secret, or provider operation is performed.
 */
declare(strict_types=1);

const SHARITY_NGO_PREF_SOURCE_VERSION = 'v1';
const SHARITY_NGO_PREF_CODE_TTL = 60;
const SHARITY_NGO_PREF_BEARER_TTL = 900;
const SHARITY_NGO_PREF_CACHE_CONTROL = 'private, no-store';

function sharity_ngo_pref_normalize_origin(string $origin): ?string
{
    $parts = parse_url(trim($origin));
    if (!is_array($parts) || ($parts['scheme'] ?? '') !== 'https' || empty($parts['host'])) {
        return null;
    }
    foreach (['user', 'pass', 'path', 'query', 'fragment'] as $forbidden) {
        if (array_key_exists($forbidden, $parts)) {
            return null;
        }
    }
    $host = strtolower((string) $parts['host']);
    if ($host === '' || str_contains($host, '*')) {
        return null;
    }
    $port = isset($parts['port']) ? (int) $parts['port'] : 443;
    if ($port !== 443) {
        return 'https://' . $host . ':' . $port;
    }
    return 'https://' . $host;
}

function sharity_ngo_pref_exact_origin(string $provided, string $canonical): bool
{
    $left = sharity_ngo_pref_normalize_origin($provided);
    $right = sharity_ngo_pref_normalize_origin($canonical);
    return $left !== null && $right !== null && hash_equals($right, $left);
}

function sharity_ngo_pref_owner_grant_admitted(string $pseudo_id): bool
{
    return $pseudo_id !== ''
        && function_exists('impactshop_identity_owner_authorized')
        && impactshop_identity_owner_authorized($pseudo_id);
}

function sharity_ngo_pref_subject_key(string $pseudo_id, string $secret, string $version = SHARITY_NGO_PREF_SOURCE_VERSION): ?string
{
    $normalized = strtolower(trim($pseudo_id));
    if ($normalized === '' || $secret === '' || $version !== SHARITY_NGO_PREF_SOURCE_VERSION) {
        return null;
    }
    return $version . ':' . rtrim(strtr(base64_encode(hash_hmac('sha256', $normalized, $secret, true)), '+/', '-_'), '=');
}

function sharity_ngo_pref_redirect_uri_valid(string $redirect): bool
{
    $parts = parse_url($redirect);
    if (!is_array($parts) || ($parts['scheme'] ?? '') !== 'https' || empty($parts['host'])) {
        return false;
    }
    foreach (['user', 'pass', 'fragment'] as $forbidden) {
        if (array_key_exists($forbidden, $parts)) {
            return false;
        }
    }
    return !str_contains($redirect, '*');
}

function sharity_ngo_pref_client_redirect_allowed(array $registry, string $client, string $redirect): bool
{
    if ($client === '' || !sharity_ngo_pref_redirect_uri_valid($redirect) || str_contains($client, '*')) {
        return false;
    }
    $registered = $registry[$client] ?? null;
    if (!is_array($registered)) {
        return false;
    }
    foreach ($registered as $candidate) {
        if (is_string($candidate) && hash_equals($candidate, $redirect)) {
            return true;
        }
    }
    return false;
}

function sharity_ngo_pref_pkce_valid(string $verifier, string $challenge): bool
{
    if ($verifier === '' || $challenge === '') {
        return false;
    }
    $digest = rtrim(strtr(base64_encode(hash('sha256', $verifier, true)), '+/', '-_'), '=');
    return hash_equals($challenge, $digest);
}

function sharity_ngo_pref_issue_code(array &$codes, string $code, array $claims, int $now): bool
{
    if (strlen($code) !== 32 || empty($claims['owner_grant_hash']) || empty($claims['subject'])
        || empty($claims['client_id']) || str_contains((string) $claims['client_id'], '*')
        || !sharity_ngo_pref_redirect_uri_valid((string) ($claims['redirect_uri'] ?? ''))
        || empty($claims['pkce_challenge'])) {
        return false;
    }
    $digest = hash('sha256', $code);
    if (isset($codes[$digest])) {
        return false;
    }
    $codes[$digest] = [
        'owner_grant_hash' => (string) $claims['owner_grant_hash'],
        'subject' => (string) $claims['subject'],
        'client_id' => (string) $claims['client_id'],
        'redirect_uri' => (string) $claims['redirect_uri'],
        'pkce_challenge' => (string) $claims['pkce_challenge'],
        'expires_at' => $now + SHARITY_NGO_PREF_CODE_TTL,
        'consumed_at' => null,
    ];
    return true;
}

function sharity_ngo_pref_redeem_code(array &$codes, string $code, string $owner_grant_hash, string $client, string $redirect, string $verifier, int $now): ?string
{
    $digest = hash('sha256', $code);
    $entry = $codes[$digest] ?? null;
    if (!is_array($entry) || $entry['consumed_at'] !== null || (int) $entry['expires_at'] < $now) {
        return null;
    }
    $codes[$digest]['consumed_at'] = $now;
    if (!hash_equals((string) $entry['owner_grant_hash'], $owner_grant_hash)
        || !hash_equals((string) $entry['client_id'], $client)
        || !hash_equals((string) $entry['redirect_uri'], $redirect)
        || !sharity_ngo_pref_pkce_valid($verifier, (string) $entry['pkce_challenge'])) {
        return null;
    }
    return (string) $entry['subject'];
}

function sharity_ngo_pref_csrf_digest(string $secret, string $owner_grant_hash, string $client, string $redirect, string $challenge, string $nonce): string
{
    return hash_hmac('sha256', implode("\n", [$owner_grant_hash, $client, $redirect, $challenge, $nonce]), $secret);
}

function sharity_ngo_pref_token_key(string $token): string
{
    return hash('sha256', $token);
}

function sharity_ngo_pref_consume_csrf(array &$tokens, string $token, string $expected_digest, int $now): bool
{
    $key = sharity_ngo_pref_token_key($token);
    $entry = $tokens[$key] ?? null;
    if (!is_array($entry) || !empty($entry['used']) || (int) ($entry['expires_at'] ?? 0) < $now) {
        return false;
    }
    if (!hash_equals((string) ($entry['digest'] ?? ''), $expected_digest)) {
        return false;
    }
    $tokens[$key]['used'] = true;
    return true;
}

function sharity_ngo_pref_bearer_active(array $session, int $now, string $owner_grant_hash): bool
{
    return empty($session['revoked_at'])
        && (int) ($session['expires_at'] ?? 0) >= $now
        && hash_equals((string) ($session['owner_grant_hash'] ?? ''), $owner_grant_hash);
}

function sharity_ngo_pref_catalog_revision(array $rows): string
{
    $normalized = [];
    foreach ($rows as $row) {
        $normalized[] = [
            'id' => (int) ($row['sharity_ngo_id'] ?? 0),
            'active' => (int) !empty($row['master_active']),
            'source_row_hash' => (string) ($row['source_row_hash'] ?? ''),
            'allow' => (int) !empty($row['policy_allow_user_selection']),
            'state' => (string) ($row['policy_state'] ?? ''),
            'policy_version' => (int) ($row['policy_version'] ?? 0),
        ];
    }
    usort($normalized, static fn (array $a, array $b): int => $a['id'] <=> $b['id']);
    return 'catalog-v2:' . hash('sha256', json_encode($normalized, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES));
}

function sharity_ngo_pref_selection_status(array $master, ?array $policy, int $ngo_id): string
{
    if ((int) ($master['sharity_ngo_id'] ?? 0) !== $ngo_id || empty($master['master_active'])) {
        return 'selection_required';
    }
    if ($policy === null || empty($policy['allow_user_selection']) || ($policy['state'] ?? '') !== 'active') {
        return 'selection_required';
    }
    return 'selectable';
}

function sharity_ngo_pref_origin_post_allowed(?string $origin, string $canonical_origin, bool $csrf_valid): bool
{
    return $origin !== null && $origin !== '' && sharity_ngo_pref_exact_origin($origin, $canonical_origin) && $csrf_valid;
}

function sharity_ngo_pref_response_headers(): array
{
    return ['Cache-Control' => SHARITY_NGO_PREF_CACHE_CONTROL];
}

function sharity_ngo_pref_table_names(): array
{
    return [
        ['name' => 'authorization_codes', 'writes' => ['issue', 'consume']],
        ['name' => 'web_sessions', 'writes' => ['issue', 'revoke']],
        ['name' => 'catalog_policy', 'writes' => ['explicit_activation_only']],
        ['name' => 'preferences', 'writes' => ['cas']],
        ['name' => 'preference_audit', 'writes' => ['append_only']],
    ];
}

function sharity_ngo_pref_cas_update(array &$preferences, array &$idempotency, array &$audit, string $subject, string $scope, int $ngo_id, string $revision, string $current_revision, string $selection_status, int $expected_version, string $idempotency_key, int $now): string
{
    if ($subject === '' || $scope === '' || $ngo_id <= 0 || $revision === '' || $idempotency_key === '') {
        return 'invalid';
    }
    if ($revision !== $current_revision) {
        return 'stale_revision';
    }
    if ($selection_status !== 'selectable') {
        return 'selection_required';
    }
    $fingerprint = hash('sha256', implode("\n", [$subject, $scope, (string) $ngo_id, $revision, (string) $expected_version]));
    if (array_key_exists($idempotency_key, $idempotency)) {
        return (($idempotency[$idempotency_key]['fingerprint'] ?? '') === $fingerprint)
            ? 'idempotent_replay' : 'idempotency_conflict';
    }
    $key = $subject . ':' . $scope;
    $current = $preferences[$key] ?? ['version' => 0];
    if ((int) $current['version'] !== $expected_version) {
        return 'conflict';
    }
    $next = $expected_version + 1;
    $preferences[$key] = ['ngo_id' => $ngo_id, 'revision' => $revision, 'version' => $next, 'updated_at' => $now];
    $idempotency[$idempotency_key] = ['fingerprint' => $fingerprint, 'storage_key' => $key, 'result' => 'updated'];
    $audit[] = [
        'operation_id' => $idempotency_key,
        'subject' => $subject,
        'scope' => $scope,
        'before_ngo_id' => $current['ngo_id'] ?? null,
        'after_ngo_id' => $ngo_id,
        'before_version' => (int) $current['version'],
        'after_version' => $next,
        'catalog_revision' => $revision,
        'outcome' => 'updated',
        'at' => $now,
    ];
    return 'updated';
}

/**
 * Registration is intentionally inert while this file is .off. The future
 * activation path must register only the documented source routes and must
 * keep browser-origin preference mutation disabled.
 */
function sharity_ngo_pref_source_routes(): array
{
    return [
        ['method' => 'GET', 'path' => '/identity/web-session/authorize', 'auth' => 'owner-grant-intent', 'handler' => 'fail_closed_until_enabled'],
        ['method' => 'POST', 'path' => '/identity/web-session/authorize', 'auth' => 'exact-origin-csrf-owner-grant', 'handler' => 'fail_closed_until_enabled'],
        ['method' => 'POST', 'path' => '/identity/web-session/token', 'auth' => 'confidential-bff-pkce', 'handler' => 'fail_closed_until_enabled'],
        ['method' => 'GET', 'path' => '/identity/web-session/summary', 'auth' => 'bearer', 'handler' => 'fail_closed_until_enabled'],
        ['method' => 'POST', 'path' => '/identity/web-session/revoke', 'auth' => 'bearer-or-bff', 'handler' => 'fail_closed_until_enabled'],
        ['method' => 'GET', 'path' => '/ngo-preferences', 'auth' => 'bearer', 'handler' => 'fail_closed_until_enabled'],
        ['method' => 'PUT', 'path' => '/ngo-preferences/{scope_key}', 'auth' => 'bearer-cas', 'handler' => 'fail_closed_until_enabled'],
    ];
}
