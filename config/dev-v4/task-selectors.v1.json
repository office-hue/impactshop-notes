{
  "schemaVersion": 1,
  "contractId": "dev-v4.task-selectors",
  "status": "active",
  "authority": "base-git-object",
  "candidateAuthority": false,
  "exclusiveWriteSurfaces": [
    {"path": "config/dev-v4/", "owner": "dev-governance-source"},
    {"path": "config/dev-delivery-v2-policy.json", "owner": "dev-governance-source"},
    {"path": "scripts/dev-v4-", "owner": "dev-governance-source"},
    {"path": "tests/dev-v4-", "owner": "dev-governance-source"}
  ],
  "selectors": {
    "maintenance-docs": {
      "lane": "maintenance", "requiresPlanId": false, "writeSurface": ["docs/", "notes.md", "system-status-snapshot.md"], "requiredCapabilities": []
    },
    "normal-source-short-brief": {
      "lane": "standard", "requiresPlanId": false, "requiresTaskBrief": false,
      "writeSurface": ["apps/", "packages/", "tools/", "src/", "docs/", "tests/"], "requiredCapabilities": ["node-test"]
    },
    "dev-governance-source": {
      "lane": "protected", "requiresPlanId": true, "requiresTaskBrief": false,
      "writeSurface": ["AGENTS.md", "config/", "scripts/", "tests/", "docs/", "notes.md", "system-status-snapshot.md"], "requiredCapabilities": ["node-test", "git-readback"]
    }
  }
}
